{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danny-rossenaar",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference, must match "name". See https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "danny-rossenaar",
    },
  ],
  // next/image optimisation via Cloudflare Images.
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  // RESEND_API_KEY is a secret: `npx wrangler secret put RESEND_API_KEY`.
}
